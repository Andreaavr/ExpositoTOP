# =============================================================================
# Doxyfile - ExpositoTOP (RTVRPTW: Recomendador Turístico con Ventanas de Tiempo)
# Solo se indican las opciones que difieren de los valores por defecto.
# Uso: doxygen Doxyfile   (o mvn -Pdocs package)
# Requiere Graphviz (dot) para los grafos y LaTeX para el PDF (make -C target/doxygen/latex).
# =============================================================================

#--- Proyecto -----------------------------------------------------------------
PROJECT_NAME           = "ExpositoTOP"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "RTVRPTW: Recomendador Turístico con Ventanas de Tiempo (TOPTW + GRASP)"
OUTPUT_DIRECTORY       = target/doxygen
OUTPUT_LANGUAGE        = Spanish
CREATE_SUBDIRS         = NO

#--- Interpretación del código Java -------------------------------------------
OPTIMIZE_OUTPUT_JAVA   = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = NO
INLINE_INHERITED_MEMB  = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = src/main/java

#--- Qué se extrae -------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
SORT_MEMBER_DOCS       = NO
SHOW_NAMESPACES        = YES

#--- Avisos --------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = target/doxygen/warnings.log

#--- Entrada -------------------------------------------------------------------
INPUT                  = doxygen/mainpage.md src/main/java
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.java *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */test/*
USE_MDFILE_AS_MAINPAGE = doxygen/mainpage.md
IMAGE_PATH             = docs/assets

#--- Navegación por el código fuente ------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
ALPHABETICAL_INDEX     = YES

#--- HTML ----------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
# Tema opcional Doxygen Awesome (git submodule add https://github.com/jothepro/doxygen-awesome-css):
# HTML_EXTRA_STYLESHEET  = doxygen-awesome-css/doxygen-awesome.css

#--- LaTeX / PDF (refman.pdf) -------------------------------------------------
GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
USE_PDFLATEX           = YES
PDF_HYPERLINKS         = YES
PAPER_TYPE             = a4
COMPACT_LATEX          = NO
LATEX_BATCHMODE        = YES

#--- XML (lo consume MkDoxy) --------------------------------------------------
GENERATE_XML           = YES
XML_OUTPUT             = xml

#--- Grafos y diagramas con Graphviz ------------------------------------------
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_MULTI_TARGETS      = YES
DOT_GRAPH_MAX_NODES    = 60
MAX_DOT_GRAPH_DEPTH    = 0
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 12
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_CLEANUP            = YES